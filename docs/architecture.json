  "cards": [
    {
      "dot": "cyan",
      "title": "Estado actual (commit 5f2f9ca)",
      "items": [
        "Solo backend + extensión: sin tests, sin README, sin CI",
        "Adquirir pack es gratis: no hay pagos implementados",
        "DEBUG=True, SECRET_KEY en el repo y CORS_ALLOW_ALL_ORIGINS=True"
      ]
    },
    {
      "dot": "amber",
      "title": "Dónde mirar al retomar",
      "items": [
        "Las imágenes estáticas se convierten a data URI por el mixed content HTTPS",
        "Los Lottie animados se piden como JSON al service worker",
        "El refresh del access token vive solo en el cliente (sin blacklist)"
      ]
    }
  ]
