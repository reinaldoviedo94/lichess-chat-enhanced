{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Lichess Chat Enhanced — plano ToolJet (diseño y operación)",
    "subtitle": "ToolJet prototipa y opera; la extensión se shippa sin ToolJet. Solo cruzan tokens y datos.",
    "locale": "en",
    "output": "docs/tooljet.html",
    "viewBox": [
      1020,
      640
    ],
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "default": {
          "label": "consulta de datos"
        },
        "emphasis": {
          "label": "lo único que llega al runtime"
        },
        "security": {
          "label": "credencial, fuera de git"
        },
        "dashed": {
          "label": "versionado en el repo, revisado en PR"
        }
      }
    },
    "views": [
      {
        "id": "design-loop",
        "label": "Loop de diseño",
        "focus": [
          "agent",
          "mcp",
          "design-lab",
          "theme",
          "tokens-json",
          "tokens-css",
          "picker"
        ],
        "note": "Del prompt al prototipo, del tema al CSS que se shippa."
      },
      {
        "id": "token-bridge",
        "label": "Puente de tokens",
        "focus": [
          "design-lab",
          "theme",
          "tokens-json",
          "tokens-css",
          "picker"
        ],
        "note": "Lo único que cruza de diseño a runtime: variables CSS."
      },
      {
        "id": "ops-console",
        "label": "Consola de packs",
        "focus": [
          "agent",
          "mcp",
          "console",
          "django-api"
        ],
        "note": "ToolJet opera la API Django; Django sigue siendo la única fuente de verdad."
      },
      {
        "id": "secrets",
        "label": "Credenciales",
        "focus": [
          "pat",
          "mcp"
        ],
        "note": "El PAT se ancla a un workspace, vive fuera de git y solo actúa en desarrollo."
      }
    ]
  },
  "stages": [
    {
      "label": "Diseño"
    },
    {
      "label": "ToolJet"
    },
    {
      "label": "Contratos en git"
    },
    {
      "label": "Runtime y datos"
    }
