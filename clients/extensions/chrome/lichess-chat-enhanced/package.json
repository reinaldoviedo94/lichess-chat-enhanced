{
  "name": "lichess-chat-enhanced",
  "version": "1.0.0",
  "description": "Custom emojis and sticker packs for Lichess chat",
  "private": true,
  "scripts": {
    "dev": "webpack --watch --mode development",
    "build": "webpack --mode production",
    "clean": "rm -rf dist",
    "tokens": "node ../../../../scripts/tokens-to-css.mjs",
    "tokens:check": "node ../../../../scripts/tokens-to-css.mjs --check",
    "test:unit": "node --test src/lib/*.test.mjs",
    "test:lifecycle": "pnpm build && node e2e/lifecycle.test.mjs",
    "test": "pnpm test:unit && pnpm test:lifecycle"
  },
  "author": "Reinaldo Oviedo Linares <reinaldoviedo94@gmail.com>",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "copy-webpack-plugin": "^13.0.0",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "lottie-web": "^5.12.2"
  }
}
